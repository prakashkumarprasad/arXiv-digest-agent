# LLM Provider: groq | gemini | ollama
LLM_PROVIDER=ollama

# Groq (free tier) - get key from https://console.groq.com
GROQ_API_KEY=

# Google AI Studio (Gemini free) - get key from https://aistudio.google.com
GEMINI_API_KEY=

# Ollama (local, no key needed) - ensure `ollama serve` is running and `ollama pull qwen2.5:7b-instruct`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Embedding model (local, no key)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Vector store
CHROMA_PERSIST_DIR=.data/chroma

# Session persistence
SQLITE_DB_PATH=.data/sessions.sqlite

# PDF cache
PDF_CACHE_DIR=.data/pdfs

# arXiv search
ARXIV_MAX_RESULTS=15
ARXIV_SORT_BY=Relevance

# Chunking
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=80

# QA
ABSTAIN_THRESHOLD=0.35
QA_TOP_K=6
QA_MMR_LAMBDA=0.6

# Logging
LOG_LEVEL=INFO